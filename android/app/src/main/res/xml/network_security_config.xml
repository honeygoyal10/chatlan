<?xml version="1.0" encoding="utf-8"?>
<!--
  LAN Chat ko office/ghar ke LAN par plain http://IP:PORT se connect karna
  padta hai (jaisa mobile.js ke hint text me bhi bataya gaya hai). Android
  9+ (targetSdk 28+) me cleartext (http) traffic by-default block hota hai,
  isliye ye config zaroori hai — warna LAN connection hamesha fail hoga,
  chahe chat ho ya attachment.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
